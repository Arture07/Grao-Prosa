rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /test/{docId} {
      allow read: if request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidGrao(data) {
      return data.keys().hasAll(['userId', 'nome', 'quantidadeRestante', 'criadoEm'])
        && data.userId is string
        && data.nome is string
        && data.nome.size() <= 200
        && data.quantidadeRestante is number
        && data.criadoEm is string;
    }

    function isValidDegustacao(data) {
      return data.keys().hasAll(['userId', 'graoId', 'graoNomeSnapshot', 'metodo', 'nota', 'criadoEm'])
        && data.userId is string
        && data.graoId is string
        && data.graoNomeSnapshot is string
        && data.metodo is string
        && data.nota is number
        && data.criadoEm is string;
    }

    match /graos/{graoId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidGrao(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidGrao(request.resource.data) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /degustacoes/{degustacaoId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidDegustacao(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidDegustacao(request.resource.data) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
